# Benchmark configuration example.
#
# Source this file before running a measurement campaign:
#   source config/gemstone-o1.env
#   ./scripts/run-full-matrix.sh
#
# Every variable is read from the environment by the scripts.

PLATFORM="gemstone-o1"

# llama.cpp build and model location
LLAMA_BIN="$HOME/llama.cpp/build/bin"
MODELS_DIR="$HOME/models"

# Model family: files are expected as <prefix>-<quant>.gguf
MODEL_PREFIX="qwen2.5-1.5b-instruct"
QUANTS="q4_0 q4_k_m q5_k_m q8_0"

# Speed matrix. CPU is the default; add "gpu:999" after confirming that the
# Vulkan build actually offloads the model. The harness aborts if a GPU
# backend is requested but the binary has no Vulkan support.
BACKENDS="cpu:0"
THREADS="1 2 3 4"
REPEATS=2

# Pause between runs, in seconds
COOLDOWN_SECONDS=3
