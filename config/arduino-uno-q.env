# Benchmark configuration for the Arduino UNO Q.
#
# Source this file before running a measurement campaign:
#   source config/arduino-uno-q.env
#   ./scripts/run-full-matrix.sh
#
# The UNO Q is available with 2 GB or 4 GB of LPDDR4X. On the 2 GB variant,
# Q8_0 (about 1.6 GB of weights) leaves very little headroom for the OS and
# the KV cache. Start with q4_0, q4_k_m, and q5_k_m and record the variant.

PLATFORM="arduino-uno-q"

LLAMA_BIN="$HOME/llama.cpp/build/bin"
MODELS_DIR="$HOME/models"

MODEL_PREFIX="qwen2.5-1.5b-instruct"
QUANTS="q4_0 q4_k_m q5_k_m q8_0"

# Vulkan support on the Adreno 702 is not yet verified for this project.
# Keep this CPU-only until a GPU run has been validated on the board.
BACKENDS="cpu:0"
THREADS="1 2 3 4"
REPEATS=2

COOLDOWN_SECONDS=3
